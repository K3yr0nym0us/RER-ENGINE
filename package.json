{
  "name": "rer-engine",
  "version": "0.1.0",
  "description": "RER-ENGINE — React, Electron, Rust Engine",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "Kevin Martinez",
    "email": "kevinmartinezbarra@gmail.com",
    "url": "https://keyron.dev"
  },
  "contributors": [],
  "scripts": {
    "predev": "node ./scripts/prune-rust-target.mjs debug && yarn rust:build:editor",
    "dev": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=debug electron-vite dev",
    "dev:local": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=debug electron-vite dev",
    "start": "node ./scripts/prune-rust-target.mjs release && yarn rust:build:editor:release && cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=release electron-vite dev",
    "start:local": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=release electron-vite dev",
    "prebuild": "yarn rust:build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "predist": "yarn rust:build:release",
    "dist": "electron-vite build && electron-builder",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rust:build": "node ./scripts/build-rust.mjs debug all",
    "rust:build:editor": "node ./scripts/build-rust.mjs debug editor",
    "rust:build:release": "node ./scripts/build-rust.mjs release all",
    "rust:build:editor:release": "node ./scripts/build-rust.mjs release editor",
    "rust:clean": "cargo clean --manifest-path src/main/Engine/Cargo.toml",
    "rust:clean:dev": "cargo clean --manifest-path src/main/Engine/Cargo.toml --profile dev",
    "rust:clean:release": "cargo clean --manifest-path src/main/Engine/Cargo.toml --profile release",
    "rust:clean:ci": "cargo clean --manifest-path src/main/Engine/Cargo.toml --target-dir src/main/Engine/target-ci",
    "rust:prune": "node ./scripts/prune-rust-target.mjs debug",
    "rust:fmt": "cargo fmt --manifest-path src/main/Engine/Cargo.toml --all -- --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src/main/Engine/Cargo.toml --all",
    "rust:check": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci cargo check --manifest-path src/main/Engine/Cargo.toml --workspace --all-targets",
    "rust:clippy": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci cargo clippy --manifest-path src/main/Engine/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci cargo test --manifest-path src/main/Engine/Cargo.toml --workspace --all-features",
    "rust:test:engine3d": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-suite.mjs engine3d",
    "rust:test:engine2d": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-suite.mjs engine2d",
    "rust:test:worldgen": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-suite.mjs worldgen",
    "rust:test:all": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-suite.mjs all",
    "rust:audit": "cargo audit --file src/main/Engine/Cargo.lock",
    "quality:frontend": "yarn lint && yarn typecheck && yarn test:coverage",
    "quality:rust": "cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-quality.mjs && cross-env CARGO_TARGET_DIR=src/main/Engine/target-ci node ./scripts/run-rust-suite.mjs all",
    "quality": "yarn quality:frontend && yarn quality:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}
