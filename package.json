{
  "name": "rer-engine",
  "version": "0.1.0",
  "description": "RER-ENGINE — React, Electron, Rust Engine",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "Kevin Martinez",
    "email": "kevinmartinezbarra@gmail.com",
    "url": "https://keyron.dev"
  },
  "contributors": [],
  "scripts": {
    "predev": "cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-2d && cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-3d && cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-shared",
    "dev": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=debug electron-vite dev",
    "start": "cargo build --release --manifest-path src/main/Engine/Cargo.toml -p rer-engine-2d -p rer-engine-3d -p rer-engine-shared && cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true RER_ENGINE_PROFILE=release electron-vite dev",
    "prebuild": "cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-2d && cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-3d && cargo build --manifest-path src/main/Engine/Cargo.toml -p rer-engine-shared",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "predist": "cargo build --release --manifest-path src/main/Engine/Cargo.toml -p rer-engine-2d && cargo build --release --manifest-path src/main/Engine/Cargo.toml -p rer-engine-3d && cargo build --release --manifest-path src/main/Engine/Cargo.toml -p rer-engine-shared",
    "dist": "electron-vite build && electron-builder",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cargo fmt --manifest-path src/main/Engine/Cargo.toml --all -- --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src/main/Engine/Cargo.toml --all",
    "rust:check": "cargo check --manifest-path src/main/Engine/Cargo.toml --workspace --all-targets",
    "rust:clippy": "cargo clippy --manifest-path src/main/Engine/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src/main/Engine/Cargo.toml --workspace --all-features",
    "rust:audit": "cargo audit --file src/main/Engine/Cargo.lock",
    "quality:frontend": "yarn lint && yarn typecheck && yarn test:coverage",
    "quality:rust": "node ./scripts/run-rust-quality.mjs",
    "quality": "yarn quality:frontend && yarn quality:rust",
    "sonar": "node ./scripts/run-sonar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.11.0",
    "adm-zip": "^0.5.17",
    "bootstrap": "^5.3.8",
    "monaco-editor": "^0.55.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6"
  }
}
