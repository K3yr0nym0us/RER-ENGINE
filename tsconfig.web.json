{
  "compilerOptions": {
    "composite":        true,
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "target":           "ESNext",
    "lib":              ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared-types": ["./src/shared-types/types.ts"],
      "@modal": ["./src/renderer/src/context/ModalContext.tsx"],
      "@engine": ["./src/renderer/src/context/useContextEngine.tsx"],
      "@hooks": ["./src/renderer/src/hooks/index.ts"],
      "@components": ["./src/renderer/src/components/index.ts"],
      "@context": ["./src/renderer/src/context/index.ts"],
    },
    "outDir":           "out",
    "strict":                        true,
    "noImplicitAny":                 true,
    "strictNullChecks":              true,
    "noUnusedLocals":                true,
    "noUnusedParameters":            true,
    "noFallthroughCasesInSwitch":    true,
    "forceConsistentCasingInFileNames": true,
    "noEmit":                        false,
    "sourceMap":                     true,
    "jsx":                           "react-jsx",
    "esModuleInterop":               true,
    "isolatedModules":               true,
    "skipLibCheck":                  true
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared-types/**/*",
    "src/renderer/src/locales/translations.json"
  ]
}
