#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 0) rayPayloadEXT vec3 payload;

layout(set = 0, binding = 0) uniform Camera {
    mat4 inv_view_proj;
    vec4 cam_pos;
    vec4 resolution;
    vec4 light_dir;
} cam;

layout(set = 0, binding = 1, rgba8) uniform image2D image_out;
layout(set = 0, binding = 2) uniform accelerationStructureEXT tlas;

void main() {
    vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 uv = pixel / max(cam.resolution.xy, vec2(1.0));
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    vec4 target = cam.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(target.xyz / target.w - cam.cam_pos.xyz);
    payload = vec3(0.72, 0.86, 0.98);
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xffu, 0u, 0u, 0u, cam.cam_pos.xyz, 0.02, dir, 10000.0, 0);
    imageStore(image_out, ivec2(gl_LaunchIDEXT.xy), vec4(payload, 1.0));
}
