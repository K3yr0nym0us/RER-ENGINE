#version 460
// Sombras volumétricas (paso 2): convierte la rejilla atómica R32U a un volumen R16F
// muestreable. Escala fija 12.4 (la misma del splat) y techo para evitar picos.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0, r32ui) uniform readonly uimage3D density_u;
layout(set = 0, binding = 1, r32f) uniform writeonly image3D density_out;
layout(set = 0, binding = 2) uniform VolParams {
    vec4 center;
    vec4 half_extent;
    vec4 resolution;
    vec4 light_dir;
    vec4 params;
    vec4 history_center;
    vec4 history_meta;
} vol;

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(cell, ivec3(vol.resolution.xyz)))) {
        return;
    }
    float rho = float(imageLoad(density_u, cell).x) / 4096.0;
    imageStore(density_out, cell, vec4(min(rho, 8.0), 0.0, 0.0, 0.0));
}
