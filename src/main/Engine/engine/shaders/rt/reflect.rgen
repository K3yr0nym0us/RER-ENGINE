#version 460
#extension GL_EXT_ray_tracing : require

// Umbral compartido con ssr.frag / composite.frag / trace.comp: por debajo de REFL_MIRROR_ROUGHNESS_MAX
// el reflejo lo da SSR. El límite superior ya no es constante: lo da el tier RTX en cam.rt_params.w.
const float REFL_MIRROR_ROUGHNESS_MAX = 0.04;
const int MAX_RAYS = 4;
const int MAX_BOUNCES = 3;

// Un único payload (Vulkan permite solo UNA variable IncomingRayPayloadKHR por entry point).
// color.rgb = color del impacto/cielo, hit.xyz = normal, hit.w = distancia (0 = miss).
struct RayPayload {
    vec4 color;
    vec4 hit;
};
layout(location = 0) rayPayloadEXT RayPayload payload;

layout(set = 0, binding = 0) uniform Camera {
    mat4 inv_view_proj;
    vec4 cam_pos;
    vec4 resolution;
    vec4 light_dir;
    vec4 sky_center_radius; // xyz = centro de la esfera, w = radio
    vec4 sky_bottom;        // rgb = azul muy oscuro, casi negro (cara inferior)
    vec4 sky_top;           // rgb = azul (cara superior), w = punto de azul pleno
    vec4 sky_sun;           // xyz = dirección al sol, w = intensidad del brillo
    vec4 sky_sun_color;     // rgb = azul claro del brillo
    vec4 rt_params;         // x = rayos/píxel, y = rebotes, z = distancia, w = roughness máx.
} cam;

layout(set = 0, binding = 1, rgba8) uniform image2D image_out;
layout(set = 0, binding = 2) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 4) uniform sampler2D depth_tex;
layout(set = 0, binding = 5) uniform sampler2D normal_tex;
// .a = flag de material reflectivo calculado en forward.frag (metales / IOR).
layout(set = 0, binding = 7) uniform sampler2D albedo_tex;

vec3 sky_color(vec3 origin, vec3 dir) {
    float radius = max(cam.sky_center_radius.w, 0.001);
    vec3 oc = origin - cam.sky_center_radius.xyz;
    float b = dot(oc, dir);
    float c = dot(oc, oc) - radius * radius;
    float h = b * b - c;
    float t = h > 0.0 ? -b + sqrt(h) : -b;
    vec3 p = origin + dir * max(t, 0.0);
    float f = clamp((p.y - cam.sky_center_radius.y) / radius * 0.5 + 0.5, 0.0, 1.0);
    float k = clamp(f / max(cam.sky_top.w, 0.001), 0.0, 1.0);
    k = k * k * (3.0 - 2.0 * k);
    vec3 base = mix(cam.sky_bottom.rgb, cam.sky_top.rgb, k);
    base *= mix(0.12, 1.0, clamp(cam.sky_sun_color.w, 0.0, 1.0));
    float glow = 0.0;
    vec3 to_sun = cam.sky_sun.xyz - origin;
    float sun_len = length(to_sun);
    if (sun_len > 0.001 && cam.sky_sun.w > 0.0) {
        float alignment = max(dot(dir, to_sun / sun_len), 0.0);
        glow = pow(alignment, 6.0) * cam.sky_sun.w;
    }
    return mix(base, cam.sky_sun_color.rgb, clamp(glow, 0.0, 1.0));
}

// Pequeña dispersión determinista para los rayos extra del mismo píxel.
vec2 ray_jitter(int index) {
    const vec2 offsets[4] = vec2[4](
        vec2( 0.25,  0.33),
        vec2(-0.30,  0.17),
        vec2( 0.12, -0.28),
        vec2(-0.18, -0.11)
    );
    return offsets[index % 4];
}

void main() {
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(pix) + vec2(0.5)) / max(cam.resolution.xy, vec2(1.0));
    float depth = texture(depth_tex, uv).r;
    if (depth >= 0.9999) {
        imageStore(image_out, pix, vec4(0.0));
        return;
    }
    // Solo materiales reflectivos por su PBR (metales / IOR). Los cubos y suelos
    // sin SurfacePbr tienen el flag a 0 y no reciben RT en ningún tier.
    if (texture(albedo_tex, uv).a < 0.5) {
        imageStore(image_out, pix, vec4(0.0));
        return;
    }
    vec3 normal = texture(normal_tex, uv).xyz * 2.0 - 1.0;
    float roughness = texture(normal_tex, uv).w;
    // En modo RT los espejos también los resuelve el rayo: en RT no se ejecuta SSR.
    if (roughness > cam.rt_params.w) {
        imageStore(image_out, pix, vec4(0.0));
        return;
    }
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    vec4 world_h = cam.inv_view_proj * vec4(ndc, depth, 1.0);
    vec3 world = world_h.xyz / world_h.w;
    vec3 n = normalize(normal);

    int rays = clamp(int(cam.rt_params.x), 1, MAX_RAYS);
    // Rebotes reales solo en superficies rugosas: en espejos (roughness baja) un segundo
    // rebote toca el suelo y vuelve a la esfera, produciendo el reflejo duplicado/recursivo.
    int bounces = roughness > 0.30 ? clamp(int(cam.rt_params.y), 1, MAX_BOUNCES) : 1;
    float t_max = max(cam.rt_params.z, 1.0);

    vec3 accumulated = vec3(0.0);
    for (int r = 0; r < rays; r++) {
        vec3 dir = normalize(reflect(normalize(world - cam.cam_pos.xyz), n) + vec3(ray_jitter(r) * roughness, 0.0));
        vec3 origin = world + n * 0.03;
        vec3 color = vec3(0.0);
        float throughput = 1.0;
        for (int b = 0; b < bounces; b++) {
            // Solo el rayo primario toma el cielo como color de fallback. Los rebotes que
            // fallan no añaden luz: antes cada miss sumaba cielo otra vez (1 + 0.5 + 0.25)
            // y High/Ultra se veían sobreiluminados.
            payload.color = b == 0 ? vec4(sky_color(origin, dir), 0.0) : vec4(0.0);
            payload.hit = vec4(0.0);
            traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xffu, 0u, 0u, 0u,
                        origin, 0.02, dir, t_max, 0);
            color += payload.color.rgb * throughput;
            if (payload.hit.w <= 0.0) {
                break;
            }
            vec3 hit_n = normalize(payload.hit.xyz);
            if (dot(hit_n, dir) > 0.0) {
                hit_n = -hit_n;
            }
            origin = origin + dir * payload.hit.w + hit_n * 0.02;
            dir = reflect(dir, hit_n);
            throughput *= 0.35;
        }
        accumulated += color;
    }
    float confidence = 1.0 - min(roughness, cam.rt_params.w);
    imageStore(image_out, pix, vec4(accumulated / float(rays), confidence));
}
