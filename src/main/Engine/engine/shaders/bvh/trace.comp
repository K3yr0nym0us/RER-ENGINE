#version 460
layout(local_size_x = 8, local_size_y = 8) in;

// Mismos umbrales que el trazado por hardware (reflect.rgen) y que SSR/composite, para que el
// fallback por software y el camino de RT no delimiten superficies distintas.
const float REFL_MIRROR_ROUGHNESS_MAX = 0.04;
const int MAX_RAYS = 4;
const int MAX_BOUNCES = 3;

struct BvhNode {
    vec4 bbox_min;
    vec4 bbox_max;
    uint left_or_tri_offset;
    uint right_or_tri_count;
    uint flags;
    uint pad;
};

struct Tri {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 uv0;
    vec4 uv1;
    vec4 uv2;
};

struct Material {
    vec4 albedo;
    vec4 pbr;
    vec4 probe;
};

layout(set = 0, binding = 0) uniform TraceU {
    mat4 inv_view_proj;
    vec4 cam_pos;
    vec4 resolution;
    vec4 light_dir;
    uvec4 counts;
    vec4 sky_center_radius; // xyz = centro de la esfera, w = radio
    vec4 sky_bottom;        // rgb = azul muy oscuro, casi negro (cara inferior)
    vec4 sky_top;           // rgb = azul (cara superior), w = punto de azul pleno
    vec4 sky_sun;           // xyz = dirección al sol, w = intensidad del brillo
    vec4 sky_sun_color;     // rgb = azul claro del brillo
    vec4 rt_params;         // x = rayos/píxel, y = rebotes, z = distancia, w = roughness máx.
} u;

// Intersección con la esfera de cielo y degradado vertical: azul oscuro abajo, azul cielo arriba.
vec3 sky_color(vec3 origin, vec3 dir) {
    float radius = max(u.sky_center_radius.w, 0.001);
    vec3 oc = origin - u.sky_center_radius.xyz;
    float b = dot(oc, dir);
    float c = dot(oc, oc) - radius * radius;
    float h = b * b - c;
    // Desde dentro h > 0 y la salida es la raíz positiva; si no, avanzar -b.
    float t = h > 0.0 ? -b + sqrt(h) : -b;
    vec3 p = origin + dir * max(t, 0.0);
    float f = clamp((p.y - u.sky_center_radius.y) / radius * 0.5 + 0.5, 0.0, 1.0);
    float k = clamp(f / max(u.sky_top.w, 0.001), 0.0, 1.0);
    k = k * k * (3.0 - 2.0 * k);
    vec3 base = mix(u.sky_bottom.rgb, u.sky_top.rgb, k);
    // De noche el cielo se oscurece (sin llegar a negro absoluto).
    base *= mix(0.12, 1.0, clamp(u.sky_sun_color.w, 0.0, 1.0));
    // El brillo más claro se alinea con el sol y se mueve con él.
    float glow = 0.0;
    vec3 to_sun = u.sky_sun.xyz - origin;
    float sun_len = length(to_sun);
    if (sun_len > 0.001 && u.sky_sun.w > 0.0) {
        float alignment = max(dot(dir, to_sun / sun_len), 0.0);
        glow = pow(alignment, 6.0) * u.sky_sun.w;
    }
    return mix(base, u.sky_sun_color.rgb, clamp(glow, 0.0, 1.0));
}

layout(set = 0, binding = 1) readonly buffer Nodes { BvhNode nodes[]; };
layout(set = 0, binding = 2) readonly buffer Tris { Tri tris[]; };
layout(set = 0, binding = 3) readonly buffer Mats { Material mats[]; };
layout(set = 0, binding = 4, rgba8) uniform image2D image_out;
layout(set = 0, binding = 5) uniform sampler2D depth_tex;
layout(set = 0, binding = 6) uniform sampler2D normal_tex;

bool ray_aabb(vec3 origin, vec3 inv_dir, vec3 bmin, vec3 bmax, float t_max) {
    vec3 t0 = (bmin - origin) * inv_dir;
    vec3 t1 = (bmax - origin) * inv_dir;
    vec3 tsmaller = min(t0, t1);
    vec3 tbigger = max(t0, t1);
    float t_near = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float t_far = min(min(tbigger.x, tbigger.y), tbigger.z);
    return t_far >= max(t_near, 0.0) && t_near < t_max;
}

bool ray_tri(vec3 origin, vec3 dir, vec3 v0, vec3 v1, vec3 v2, out float t, out vec3 n) {
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 p = cross(dir, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-8) {
        return false;
    }
    float inv_det = 1.0 / det;
    vec3 s = origin - v0;
    float u = dot(s, p) * inv_det;
    if (u < 0.0 || u > 1.0) {
        return false;
    }
    vec3 q = cross(s, e1);
    float v = dot(dir, q) * inv_det;
    if (v < 0.0 || u + v > 1.0) {
        return false;
    }
    t = dot(e2, q) * inv_det;
    if (t < 0.001) {
        return false;
    }
    n = normalize(cross(e1, e2));
    return true;
}

bool trace_bvh(vec3 origin, vec3 dir, out vec3 hit_n, out uint slot, out float t_hit, float t_max) {
    if (u.counts.x == 0u) {
        return false;
    }
    vec3 inv_dir = 1.0 / dir;
    uint stack[32];
    int sp = 0;
    stack[0] = 0u;
    float best_t = max(t_max, 0.001);
    bool hit = false;
    while (sp >= 0) {
        uint idx = stack[sp];
        sp--;
        BvhNode node = nodes[idx];
        if (!ray_aabb(origin, inv_dir, node.bbox_min.xyz, node.bbox_max.xyz, best_t)) {
            continue;
        }
        if (node.flags == 1u) {
            for (uint i = 0u; i < node.right_or_tri_count; i++) {
                Tri tri = tris[node.left_or_tri_offset + i];
                float t;
                vec3 n;
                if (ray_tri(origin, dir, tri.v0.xyz, tri.v1.xyz, tri.v2.xyz, t, n) && t < best_t) {
                    best_t = t;
                    hit_n = n;
                    slot = floatBitsToUint(tri.v0.w);
                    hit = true;
                }
            }
        } else if (sp < 30) {
            stack[++sp] = node.left_or_tri_offset;
            stack[++sp] = node.right_or_tri_count;
        }
    }
    if (hit) {
        t_hit = best_t;
    }
    return hit;
}

vec2 ray_jitter(int index) {
    const vec2 offsets[4] = vec2[4](
        vec2( 0.25,  0.33),
        vec2(-0.30,  0.17),
        vec2( 0.12, -0.28),
        vec2(-0.18, -0.11)
    );
    return offsets[index % 4];
}

vec3 shade_hit(vec3 hit_n, vec3 dir, uint slot) {
    if (dot(hit_n, dir) > 0.0) {
        hit_n = -hit_n;
    }
    vec3 albedo = mats[min(slot, max(u.counts.w, 1u) - 1u)].albedo.rgb;
    float ndotl = max(dot(hit_n, normalize(u.light_dir.xyz)), 0.0);
    float ambient = clamp(u.light_dir.w, 0.0, 1.0);
    return albedo * (ambient + (1.0 - ambient) * ndotl);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= int(u.resolution.x) || pix.y >= int(u.resolution.y)) {
        return;
    }
    vec2 uv = (vec2(pix) + vec2(0.5)) / max(u.resolution.xy, vec2(1.0));
    vec3 origin = u.cam_pos.xyz;
    vec3 dir;
    float confidence = 1.0;
    int rays = clamp(int(u.rt_params.x), 1, MAX_RAYS);
    int bounces = clamp(int(u.rt_params.y), 1, MAX_BOUNCES);
    float t_max = max(u.rt_params.z, 1.0);

    if (u.counts.z == 0u) {
        // Fondo: un solo rayo desde la cámara, igual que siempre.
        vec2 ndc = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
        vec4 target = u.inv_view_proj * vec4(ndc, 1.0, 1.0);
        dir = normalize(target.xyz / target.w - origin);
        vec3 color = sky_color(origin, dir);
        vec3 hit_n;
        uint slot;
        float t_hit;
        // El fondo usa su propia distancia: el preset RTX solo limita los reflejos.
        if (trace_bvh(origin, dir, hit_n, slot, t_hit, 10000.0)) {
            color = shade_hit(hit_n, dir, slot);
        }
        imageStore(image_out, pix, vec4(color, 1.0));
        return;
    }

    float depth = texture(depth_tex, uv).r;
    if (depth >= 0.9999) {
        imageStore(image_out, pix, vec4(0.0));
        return;
    }
    vec4 nr = texture(normal_tex, uv);
    if (nr.w <= REFL_MIRROR_ROUGHNESS_MAX || nr.w > u.rt_params.w) {
        imageStore(image_out, pix, vec4(0.0));
        return;
    }
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    vec4 world_h = u.inv_view_proj * vec4(ndc, depth, 1.0);
    vec3 world = world_h.xyz / world_h.w;
    vec3 n = normalize(nr.xyz * 2.0 - 1.0);
    dir = reflect(normalize(world - origin), n);
    confidence = 1.0 - min(nr.w, u.rt_params.w);

    vec3 accumulated = vec3(0.0);
    for (int r = 0; r < rays; r++) {
        vec3 ray_dir = normalize(dir + vec3(ray_jitter(r) * nr.w, 0.0));
        vec3 ray_origin = world + n * 0.03;
        vec3 color = vec3(0.0);
        float throughput = 1.0;
        for (int b = 0; b < bounces; b++) {
            vec3 hit_n;
            uint slot;
            float t_hit;
            if (!trace_bvh(ray_origin, ray_dir, hit_n, slot, t_hit, t_max)) {
                color += sky_color(ray_origin, ray_dir) * throughput;
                break;
            }
            color += shade_hit(hit_n, ray_dir, slot) * throughput;
            if (dot(hit_n, ray_dir) > 0.0) {
                hit_n = -hit_n;
            }
            ray_origin = ray_origin + ray_dir * t_hit + hit_n * 0.02;
            ray_dir = reflect(ray_dir, hit_n);
            throughput *= 0.5;
        }
        accumulated += color;
    }
    imageStore(image_out, pix, vec4(accumulated / float(rays), confidence));
}
